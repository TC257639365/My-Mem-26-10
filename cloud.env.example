# 千问云模型配置模板。复制到仓库外并填写真实 Key：
#   cp cloud.env.example ~/.config/my-mem/cloud.env
#   chmod 600 ~/.config/my-mem/cloud.env
#   source ~/.config/my-mem/cloud.env

# Chat Completions
export T_MEM_LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
export T_MEM_LLM_API_KEY=replace-with-your-api-key
export T_MEM_LLM_BASE_MODEL=qwen3.8-flash

# Embedding：地址和 Key 默认复用上面的 LLM 配置。
export T_MEM_LLM_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
export T_MEM_EMBEDDING_BATCH_SIZE=20
# 不设置时使用模型默认的 1024 维。修改维度后必须重建已有向量索引。
#export T_MEM_EMBEDDING_DIMENSIONS=1024

# qwen3-rerank 使用独立的 OpenAI-compatible rerank 路径（复数 reranks）。
export T_MEM_RERANKER_URL=https://maas.qianwenaiapi.com/compatible-api/v1/reranks
export T_MEM_RERANKER_MODEL=qwen3-rerank
# Key 默认复用 T_MEM_LLM_API_KEY；不同账号时再单独设置。
#export T_MEM_RERANKER_API_KEY=replace-with-your-reranker-api-key
export T_MEM_USE_RERANKER=true

export T_MEM_MAX_CONCURRENCY=4
